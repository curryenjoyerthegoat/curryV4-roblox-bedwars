-- Visual settings
local function Visuals()
    Heading("Visual Customization")
    Description("Customize your Roblox client appearance.")

    Toggle("Grey Sky","Apply grey atmospheric appearance",function(on)
        if on then
            Lighting.Ambient = Color3.fromRGB(120,120,120)
            Lighting.OutdoorAmbient = Color3.fromRGB(120,120,120)
        else
            Lighting.Ambient = Color3.fromRGB(127,127,127)
            Lighting.OutdoorAmbient = Color3.fromRGB(127,127,127)
        end
    end)

    Toggle("Fullbright","Increase client lighting",function(on)
        Lighting.Brightness = on and 3 or 1
        Lighting.GlobalShadows = not on
        Lighting.ClockTime = on and 14 or 14
    end)

    Toggle("No Shadows","Disable global shadows",function(on)
        Lighting.GlobalShadows = not on
    end)

    Toggle("Performance Mode","Reduce client rendering overhead",function(on)
        Lighting.GlobalShadows = not on
        Lighting.EnvironmentDiffuseScale = on and 0 or 1
        Lighting.EnvironmentSpecularScale = on and 0 or 1
    end)
end

-- Network diagnostics
local function Network()
    Heading("Network Diagnostics")
    Description("Client-side connection information.")

    local pingCard = Card("Network Ping","Reading connection latency...")

    local pingLabel = pingCard:FindFirstChildWhichIsA("TextLabel")
    local descLabel = pingCard:GetChildren()[3]

    local connection
    connection = RunService.Heartbeat:Connect(function()
        if not pingCard.Parent then
            connection:Disconnect()
            return
        end

        local success, ping = pcall(function()
            return Player:GetNetworkPing() * 1000
        end)

        if success then
            descLabel.Text = string.format("Approximate ping: %.0f ms",ping)
        end
    end)

    Card("RakNet Diagnostics","Client-visible networking information only.")
    Card("Desync Diagnostics","Displays synchronization status information.")
    Card("Packet Diagnostics","No packet manipulation is performed.")
end

-- Combat diagnostics
local function Combat()
    Heading("Hit Registration")
    Description("Measure client-side responsiveness.")

    local hitCard = Card("HitFix Diagnostics","Latency and responsiveness monitoring")
    local pingLabel = hitCard:FindFirstChildWhichIsA("TextLabel")

    Action("Refresh","Refresh network latency information",function()
        local success,ping = pcall(function()
            return Player:GetNetworkPing()*1000
        end)

        if success then
            pingLabel.Text = "Measured ping: "..math.floor(ping).." ms"
        end
    end)

    Card("Hit Registration","Server-authoritative hit detection cannot be changed by this UI.")
    Card("Combat Training","Diagnostic panel only.")
end

-- Performance
local function Performance()
    Heading("Performance")
    Description("Client performance information.")

    local fpsCard = Card("FPS Monitor","Measuring frame rate...")
    local fpsText = fpsCard:GetChildren()[2]

    local frames = 0
    local elapsed = 0

    local connection
    connection = RunService.RenderStepped:Connect(function(dt)
        if not fpsCard.Parent then
            connection:Disconnect()
            return
        end

        frames += 1
        elapsed += dt

        if elapsed >= 1 then
            fpsText.Text = "Client FPS: "..frames
            frames = 0
            elapsed = 0
        end
    end)

    Card("Graphics","Client-side graphics information.")
    Card("Device","Mobile interface edition.")
end

