-- 4. Core Logic Functions
local function getClosestEnemy(range)
    local char = player.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    
    local closest, closestDist
    for _, other in pairs(Players:GetPlayers()) do
        if other ~= player and other.Character then
            local otherHrp = other.Character:FindFirstChild("HumanoidRootPart")
            if otherHrp then
                local dist = (hrp.Position - otherHrp.Position).Magnitude
                if dist < range and (not closest or dist < closestDist) then
                    closest = other
                    closestDist = dist
                end
            end
        end
    end
    return closest, closestDist
end

local function findBeeTarget()
    if not state.beeCollect then return nil end
    local char = player.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    
    -- Look for Bee Keeper Kit in tool
    local hasKit = false
    for _, tool in pairs(char:GetChildren()) do
        if tool:IsA("Tool") and tool.Name:find("Bee") then
            hasKit = true
            break
        end
    end
    if not hasKit then return nil end

    -- Find closest bee
    local closestBee, closestDist
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name:find("Bee") then
            local dist = (hrp.Position - obj.Position).Magnitude
            if dist < 10 and (not closestBee or dist < closestDist) then
                closestBee = obj
                closestDist = dist
            end
        end
    end
    return closestBee
end

